{
  "name": "brauser",
  "productName": "Brauser",
  "version": "1.1.2",
  "description": "Brauser: панель управления и движок Tor Browser (Secured) плюс обычный быстрый браузер (Basic)",
  "author": {
    "name": "Brauser",
    "email": "brauser@localhost"
  },
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "node scripts/verify-vendor.js win32 && electron-builder --win nsis --x64",
    "dist:linux": "sh scripts/build-linux.sh",
    "dist:linux:docker": "pwsh -NoProfile -File scripts/build-linux.ps1",
    "test:security": "node scripts/test-security.js"
  },
  "build": {
    "appId": "local.brauser.app",
    "productName": "Brauser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "vendor",
          "to": "tor-browser-bundle",
          "filter": [
            "tor-browser-windows-x86_64-portable-*.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Brauser-Setup-${version}.exe",
      "shortcutName": "Brauser"
    },
    "linux": {
      "target": "deb",
      "category": "Network",
      "executableName": "brauser",
      "synopsis": "Панель управления Tor и движок Tor Browser",
      "artifactName": "brauser_${version}_${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor",
          "to": "tor-browser-bundle",
          "filter": [
            "tor-browser-linux-x86_64-*.tar.xz"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "xz-utils",
        "libdbus-glib-1-2",
        "libxt6t64 | libxt6",
        "libx11-xcb1"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://brauser.invalid",
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
